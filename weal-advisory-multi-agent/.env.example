# ============================================================
# 财富管理投顾多智能体 —— 环境变量样例
# 复制为 .env 并填写；未配置 OPENAI_API_KEY 时自动使用确定性 mock 大脑。
# ============================================================

# OpenAI 兼容端点（任何兼容 /v1/chat/completions 的服务均可）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# LLM 采样温度（建议低温度，保证建议书措辞稳定）
LLM_TEMPERATURE=0.2
# 单次请求超时（秒）
LLM_TIMEOUT=30

# 运行痕迹目录与建议版本链文件
RUNS_DIR=runs
VERSION_CHAIN_FILE=runs/version_chain.jsonl

# 强制 mock 模式（即使配置了 Key 也不调用真实模型）：
# 1 = 强制 mock，0 / 不设置 = 有 Key 用 Key
FORCE_MOCK_LLM=0
