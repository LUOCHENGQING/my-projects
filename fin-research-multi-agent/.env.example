# ---------------------------------------------------------------------------
# LLM 接入（可选）。不填 OPENAI_API_KEY 时，项目自动进入确定性 mock 模式，
# `python -m src.demo` 与 `pytest` 都能完整跑通，无需任何外部网络调用。
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 强制使用 mock 大脑（1/true/yes 开启）。即使填了 key 也可以打开做回归测试。
MOCK_LLM=0

# 风险反思循环的最大轮次（默认 2，超出即标记为「需人工确认」）
MAX_REVISION_ROUNDS=2

# 编排引擎：auto / langgraph / native
GRAPH_ENGINE=auto
