# ---------------------------------------------------------------------------
# 全部配置项都可以不填 —— 引擎会自动降级为确定性本地后端，离线完整跑通。
# ---------------------------------------------------------------------------

# ---- LLM（可选）------------------------------------------------------------
# 不填 OPENAI_API_KEY 时自动进入 mock 模式（确定性抽取式作答），不发任何网络请求。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30

# 强制离线模式（1/true/yes 开启）。即使填了 key，也可以打开它做可复现回归。
MOCK_LLM=0

# ---- 嵌入与重排 -------------------------------------------------------------
# local   = 确定性哈希后端（默认，零依赖、结果完全可复现）
# bge-m3  = 真实 BGE-M3（需安装 FlagEmbedding，同时给出稠密与稀疏表示）
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=512

# ---- 切分 -------------------------------------------------------------------
CHILD_CHUNK_CHARS=180
CHILD_CHUNK_OVERLAP=48
PARENT_MAX_CHARS=1400
TABLE_ROWS_PER_CHUNK=2

# ---- 检索 -------------------------------------------------------------------
RECALL_TOP_K=20          # 每路召回候选数
FINAL_TOP_K=5            # 重排后交给模型的证据条数
RRF_K=60                 # RRF 平滑常数
DEDUP_JACCARD=0.82       # 近似去重阈值
BM25_K1=1.5
BM25_B=0.75
RERANK_W_CROSS=0.55      # 交叉编码器分权重
RERANK_W_RRF=0.30        # RRF 分权重
RERANK_W_METADATA=0.15   # 元数据契合度权重

# ---- FAQ / 缓存 -------------------------------------------------------------
FAQ_MATCH_THRESHOLD=0.62
CACHE_TTL_S=600
CACHE_MAX_ENTRIES=512
# 不填则使用内存 LRU；填了但连不上也会自动降级（并在 /stats 里如实标注）
REDIS_URL=

# ---- 服务 -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# ---- 生产依赖（本地不用填）--------------------------------------------------
# MILVUS_URI=http://127.0.0.1:19530
# MYSQL_DSN=mysql://user:pass@127.0.0.1:3306/finrag
